# Copie para .env. No SERVIDOR (docker compose) defina pelo menos API_KEY e DB_PASSWORD.
# No dev local nada é obrigatório — sem .env o backend roda em SQLite, aberto.
# Prefixo QUESTPRO_ evita colisão com variáveis genéricas do sistema.

# ---- servidor (docker compose) ----
# Chave exigida nos endpoints de escrita (upload do óculos e delete). Use algo longo/aleatório.
QUESTPRO_API_KEY=
# Senha do PostgreSQL do compose.
QUESTPRO_DB_PASSWORD=troque-esta-senha
# Porta HTTP exposta pelo servidor (site + API).
QUESTPRO_HTTP_PORT=8000

# ---- avançado / dev ----
# Banco: SQLite (dev) ou Postgres. Ex.: postgresql+psycopg://questpro:senha@localhost:5432/questpro
#QUESTPRO_DB_URL=sqlite:///./questpro.db
# Pasta da mídia (frames + video.mp4).
#QUESTPRO_MEDIA_ROOT=./media
# Origem do dev server do React (CORS, só no dev).
#QUESTPRO_FRONTEND_ORIGIN=http://localhost:5173
# Build do frontend a servir como site (produção). No Docker já vem configurado.
#QUESTPRO_STATIC_DIR=./static
# Nível do log da aplicação (DEBUG, INFO, WARNING...).
#QUESTPRO_LOG_LEVEL=INFO

# ---- contas e e-mail (login do site) ----
# Chave que assina o cookie de login. Vazia = gerada e guardada em <MEDIA_ROOT>/.secret_key.
#QUESTPRO_SECRET_KEY=
# Endereço do site nos links de convite e de redefinição de senha.
#QUESTPRO_PUBLIC_BASE_URL=http://localhost:5173
# Cookie só por HTTPS (ligue no servidor com TLS).
#QUESTPRO_COOKIE_SECURE=false
# Duração do login (horas) e validade dos links de convite e de redefinição (horas).
#QUESTPRO_SESSION_HOURS=12
#QUESTPRO_INVITE_HOURS=168
#QUESTPRO_RESET_HOURS=2
# SMTP. Sem host, o admin copia o link na tela e o "esqueci minha senha" vai para o log.
# Mailpit no dev: HOST=localhost, PORT=1025, SECURITY=none.
#QUESTPRO_SMTP_HOST=
#QUESTPRO_SMTP_PORT=587
#QUESTPRO_SMTP_USER=
#QUESTPRO_SMTP_PASSWORD=
#QUESTPRO_SMTP_FROM=NeuroSight <nao-responda@neurosight.local>
#QUESTPRO_SMTP_SECURITY=starttls
