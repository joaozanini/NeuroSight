# Copie para .env (na pasta onde você roda o uvicorn, ex.: backend/) se quiser customizar.
# Tudo tem default — sem .env o backend já roda em SQLite.
# As variáveis usam o prefixo QUESTPRO_ para não colidir com variáveis genéricas do sistema.

# SQLite (dev). Para Postgres: postgresql+psycopg://questpro:questpro@localhost:5432/questpro
QUESTPRO_DB_URL=sqlite:///./questpro.db

# Pasta da mídia (frames + video.mp4), relativa a onde o uvicorn é iniciado.
QUESTPRO_MEDIA_ROOT=./media

# Origem do dev server do React (CORS).
QUESTPRO_FRONTEND_ORIGIN=http://localhost:5173

# Frames por requisição multipart no upload do device.
QUESTPRO_MAX_BATCH_FRAMES=50
